# ── Loop · environment ────────────────────────────────────────────────────────
# Copy to .env and fill. Nothing here may ever be committed.

# Database. Each service gets its own role in production (infra/compose.yaml);
# this URL is the owner role used by migrations and local development.
#
# The default is the local-development database: `scripts/test_db.py up`
# publishes Postgres on 55432, deliberately not 5432, so it cannot collide with
# one you already run, and its password is the throwaway `loop`.
#
# Under compose this variable is not used at all: nothing is published to the
# host there, so no localhost URL could work, and compose composes its own from
# POSTGRES_PASSWORD instead. This one stays pointed at whatever you can reach
# from the host, which is what `python -m loop migrate`, `scripts/seed_user.py`
# and `scripts/dev.py` connect with.
DATABASE_URL=postgres://loop:loop@localhost:55432/loop

# Compose only, and compose refuses to start without it. Unused by the local
# development flow above, where the throwaway container sets its own. Generate
# with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Changing it after the first boot does not change the password Postgres
# already stored in ./infra/data/postgres — alter the role, or start clean.
POSTGRES_PASSWORD=

# Key-encryption key, base64, 32 bytes. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# MUST NOT live in the database or the repo. Losing it means every mailbox must
# be reconnected — that is stated in the runbook on purpose.
LOOP_KEK=

# Google OAuth. Desktop-type client while the app is unverified; list your own
# address as a test user. See docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/mailboxes/gmail/callback
# Optional. Absent → the connector polls every 5 minutes instead of using push.
GOOGLE_PUBSUB_TOPIC=

# Rung 3. Unset MODEL_BASE_URL → the rung abstains and unknown templates become
# review items. That is failure state F4 and it is the default posture.
#
# A URL that is not loopback and not a compose service name is refused at
# startup unless ALLOW_HOSTED_MODEL is true: a typo in this file should not move
# email text off the box.
#
# The assistant reads the same variable and accepts a comma-separated list:
# llama-server loads one model per process, so a second URL is what makes the
# chat's model picker an actual choice. The first is the default and is the one
# rung 3 uses.
#   MODEL_BASE_URL=http://localhost:8080/v1,http://localhost:8081/v1
#
# Images need a model with a vision projector, which is a property of the
# server, not of this app: `llama-server -hf ggml-org/gemma-3-4b-it-GGUF --port
# 8081` downloads the weights and the projector together (Qwen2.5-VL-7B and
# InternVL3-8B are the same shape, larger). The panel asks each server whether
# it can see, greys out the attachment button for one that cannot, and says
# why — and a picture sent to one anyway is dropped with a note rather than a
# 500.
MODEL_BASE_URL=
MODEL_NAME=qwen2.5-7b-instruct
MODEL_TIMEOUT_MS=30000
# MUST default false. True only alongside a named processor in settings.
ALLOW_HOSTED_MODEL=false

# Web push. Generated once at first boot if absent, then persisted here.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# 0 = never persist message text. Maximum accepted value is 7.
DEBUG_RETAIN_BODIES_DAYS=0

# Notifier-enforced, in the user's timezone.
QUIET_HOURS=21:00-08:00
DAILY_PUSH_SLOT=18:00

# Optional, both compose-only and both with working defaults — listed so that
# `docker compose up` has no variable that only reading compose.yaml would
# reveal.
# VLLM_MODEL is read by the `batch` profile, which is not started by default.
LOG_LEVEL=info
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# The API
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Required, with no default, and the API refuses to start without it. Every CSRF
# token is HMAC(secret, "csrf:" + session_id) and every OAuth `state` is signed
# with the same key, so a placeholder here is a system that looks fine and is
# not. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# WebAuthn relying party. RP_ID must be the registrable domain, no scheme/port.
RP_ID=localhost
RP_NAME=Loop

# Optional. Set to a sentence-transformers model to replace the lexical stand-in
# the resolver embeds role titles with. Read §3.3 of docs/port-to-python.md
# first: ATTACH_SINGLE, ATTACH_MULTI and DEDUP_MERGE were tuned against the
# stand-in's geometry, and a merge threshold that is too low rewrites two
# applications' history into one silently.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# `json` gives one JSON object per line, which is what compose sets. Anything
# else is the human-readable format. Either way the log allow-lists its fields
# and redacts anything that looks like a secret.
# LOG_FORMAT=
